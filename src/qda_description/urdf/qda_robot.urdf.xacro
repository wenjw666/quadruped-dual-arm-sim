<?xml version="1.0"?>
<robot name="qda_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find b2_description)/xacro/const.xacro"/>
  <xacro:include filename="$(find b2_description)/xacro/materials.xacro"/>
  <xacro:include filename="$(find b2_description)/xacro/leg.xacro"/>

  <xacro:property name="stand_thigh" value="0.769"/>
  <xacro:property name="stand_calf" value="-1.459"/>
  <xacro:property name="arm_home_1" value="0.0"/>
  <xacro:property name="arm_home_2" value="-2.2"/>
  <xacro:property name="arm_home_3" value="0.0"/>
  <xacro:property name="arm_home_4" value="0.5"/>
  <xacro:property name="arm_home_5" value="0.0"/>
  <xacro:property name="arm_home_6" value="0.0"/>
  <!-- lidar_model: mid360 | ray16. camera_model: d435 | d455 | generic. -->
  <xacro:arg name="lidar_model" default="mid360"/>
  <xacro:arg name="camera_model" default="d435"/>
  <xacro:property name="lidar_model" value="$(arg lidar_model)"/>
  <xacro:property name="camera_model" value="$(arg camera_model)"/>
  <!-- Intel color FOV: D435 69.4 deg, D455 90 deg. Gazebo derives fx from this. -->
  <xacro:property name="cam_hfov" value="${1.211259 if camera_model == 'd435' else (1.5707963 if camera_model == 'd455' else 1.20)}"/>
  <xacro:property name="cam_dx" value="${0.025 if camera_model == 'd435' else (0.026 if camera_model == 'd455' else 0.050)}"/>
  <xacro:property name="cam_dy" value="${0.090 if camera_model == 'd435' else (0.124 if camera_model == 'd455' else 0.110)}"/>
  <xacro:property name="cam_dz" value="${0.025 if camera_model == 'd435' else (0.029 if camera_model == 'd455' else 0.045)}"/>

  <link name="base_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="base_to_trunk" type="fixed">
    <parent link="base_link"/>
    <child link="trunk"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="trunk">
    <visual>
      <geometry>
        <mesh filename="package://b2_description/meshes/trunk.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${trunk_com_x} ${trunk_com_y} ${trunk_com_z}" rpy="0 0 0"/>
      <mass value="${trunk_mass}"/>
      <inertia ixx="${trunk_ixx}" ixy="${trunk_ixy}" ixz="${trunk_ixz}" iyy="${trunk_iyy}" iyz="${trunk_iyz}" izz="${trunk_izz}"/>
    </inertial>
  </link>

  <xacro:leg name="FR" mirror="-1" mirror_dae="${False}" front_hind="1" front_hind_dae="${True}"/>
  <xacro:leg name="FL" mirror="1" mirror_dae="${True}" front_hind="1" front_hind_dae="${True}"/>
  <xacro:leg name="RR" mirror="-1" mirror_dae="${False}" front_hind="-1" front_hind_dae="${False}"/>
  <xacro:leg name="RL" mirror="1" mirror_dae="${True}" front_hind="-1" front_hind_dae="${False}"/>

  <!-- Back deck on the B2 trunk. Arms rise from the side pedestals and yaw outward. -->
  <link name="arm_deck">
    <visual>
      <origin xyz="0 0 0.019"/>
      <geometry><box size="0.56 0.52 0.038"/></geometry>
      <material name="deck_dark"><color rgba="0.11 0.12 0.13 1"/></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.040"/>
      <geometry><box size="0.50 0.46 0.006"/></geometry>
      <material name="deck_top"><color rgba="0.22 0.23 0.24 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.020"/>
      <geometry><box size="0.56 0.52 0.040"/></geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0.02"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.10"/>
    </inertial>
  </link>
  <joint name="arm_deck_joint" type="fixed">
    <parent link="trunk"/>
    <child link="arm_deck"/>
    <origin xyz="0.02 0 0.245"/>
  </joint>

  <link name="left_pedestal">
    <visual>
      <geometry><cylinder radius="0.070" length="0.040"/></geometry>
      <material name="pedestal"><color rgba="0.16 0.17 0.18 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.070" length="0.040"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="4e-4" ixy="0" ixz="0" iyy="4e-4" iyz="0" izz="4e-4"/>
    </inertial>
  </link>
  <joint name="left_pedestal_joint" type="fixed">
    <parent link="arm_deck"/>
    <child link="left_pedestal"/>
    <origin xyz="0.14 0.17 0.058"/>
  </joint>
  <link name="right_pedestal">
    <visual>
      <geometry><cylinder radius="0.070" length="0.040"/></geometry>
      <material name="pedestal"><color rgba="0.16 0.17 0.18 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.070" length="0.040"/></geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="4e-4" ixy="0" ixz="0" iyy="4e-4" iyz="0" izz="4e-4"/>
    </inertial>
  </link>
  <joint name="right_pedestal_joint" type="fixed">
    <parent link="arm_deck"/>
    <child link="right_pedestal"/>
    <origin xyz="0.14 -0.17 0.058"/>
  </joint>

  <link name="left_arm_mount">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="left_arm_mount_joint" type="fixed">
    <parent link="left_pedestal"/>
    <child link="left_arm_mount"/>
    <origin xyz="0 0 0.022" rpy="0 0.5 1.2"/>
  </joint>
  <link name="right_arm_mount">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="right_arm_mount_joint" type="fixed">
    <parent link="right_pedestal"/>
    <child link="right_arm_mount"/>
    <origin xyz="0 0 0.022" rpy="0 0.5 -1.2"/>
  </joint>

  <link name="sensor_mast">
    <visual>
      <origin xyz="0 0 0.11"/>
      <geometry><cylinder radius="0.026" length="0.22"/></geometry>
      <material name="mast"><color rgba="0.14 0.14 0.15 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.11"/>
      <geometry><cylinder radius="0.026" length="0.22"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.11"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="2e-4"/>
    </inertial>
  </link>
  <joint name="sensor_mast_joint" type="fixed">
    <parent link="arm_deck"/>
    <child link="sensor_mast"/>
    <origin xyz="0.14 0 0.042"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="${cam_dx} ${cam_dy} ${cam_dz}"/></geometry>
      <material name="camera_body"><color rgba="0.05 0.05 0.05 1"/></material>
    </visual>
    <visual>
      <origin xyz="${cam_dx * 0.5 + 0.001} 0 0"/>
      <geometry><box size="0.002 ${cam_dy * 0.72} ${cam_dz * 0.55}"/></geometry>
      <material name="lens"><color rgba="0.12 0.28 0.42 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${cam_dx} ${cam_dy} ${cam_dz}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="2e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="camera_link"/>
    <origin xyz="0.045 0 0.12" rpy="0 0.35 0"/>
  </joint>
  <link name="camera_optical_frame">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="lidar_link">
    <xacro:if value="${lidar_model == 'mid360'}">
      <visual>
        <geometry><cylinder radius="0.0325" length="0.060"/></geometry>
        <material name="lidar_body"><color rgba="0.10 0.10 0.11 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 0.031"/>
        <geometry><cylinder radius="0.026" length="0.004"/></geometry>
        <material name="lidar_ring"><color rgba="0.20 0.45 0.55 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.034" length="0.062"/></geometry>
      </collision>
    </xacro:if>
    <xacro:unless value="${lidar_model == 'mid360'}">
      <visual>
        <geometry><cylinder radius="0.042" length="0.048"/></geometry>
        <material name="lidar_body"><color rgba="0.08 0.08 0.09 1"/></material>
      </visual>
      <visual>
        <geometry><cylinder radius="0.034" length="0.052"/></geometry>
        <material name="lidar_ring"><color rgba="0.35 0.36 0.38 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.042" length="0.048"/></geometry>
      </collision>
    </xacro:unless>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="2e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="lidar_link"/>
    <!-- Mid-360 sees mostly above the horizon. Pitch down so the pattern covers the floor. -->
    <origin xyz="0 0 0.24" rpy="0 0.40 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="trunk"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="depth" name="head_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>${cam_hfov}</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
      <plugin name="head_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
        <min_depth>0.05</min_depth>
        <max_depth>8.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <link name="nav_scan_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.028" length="0.04"/></geometry>
      <material name="nav_scan_body"><color rgba="0.2 0.2 0.22 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.04 0.06 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="nav_scan_joint" type="fixed">
    <parent link="trunk"/>
    <child link="nav_scan_link"/>
    <origin xyz="0.38 0 0.02" rpy="0 0 0"/>
  </joint>

  <gazebo reference="nav_scan_link">
    <sensor type="ray" name="scan">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range><min>0.35</min><max>12.0</max><resolution>0.02</resolution></range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
      </ray>
      <plugin name="scan_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>nav_scan_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <xacro:if value="${lidar_model == 'mid360'}">
      <sensor type="ray" name="mid360">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <pose>0 0 0 0 0 0</pose>
        <!-- RayPlugin needs a valid parent ray sensor; the Livox plugin casts
             the 2400 actual rays itself. One trigger ray avoids duplicate work. -->
        <ray>
          <scan><horizontal><samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle>
          </horizontal></scan>
          <range><min>0.15</min><max>20.0</max><resolution>0.02</resolution></range>
          <noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise>
        </ray>
        <plugin name="mid360_plugin" filename="libros2_livox.so">
          <ros><namespace>/</namespace></ros>
          <ray>
            <scan>
              <horizontal>
                <samples>2400</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>4</samples>
                <resolution>1</resolution>
                <min_angle>-0.13</min_angle>
                <max_angle>0.96</max_angle>
              </vertical>
            </scan>
            <range><min>0.15</min><max>20.0</max><resolution>0.02</resolution></range>
          </ray>
          <samples>2400</samples>
          <downsample>1</downsample>
          <csv_file_name>$(find ros2_livox_simulation)/scan_mode/mid360.csv</csv_file_name>
          <topic>/livox/lidar</topic>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </xacro:if>
    <xacro:unless value="${lidar_model == 'mid360'}">
      <sensor type="ray" name="cloud">
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <pose>0 0 0.02 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>240</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.35</min_angle>
              <max_angle>0.35</max_angle>
            </vertical>
          </scan>
          <range><min>0.35</min><max>16.0</max><resolution>0.03</resolution></range>
        </ray>
        <plugin name="cloud_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=/fast_livo/cloud</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </xacro:unless>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/imu_raw</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:macro name="foot_contact" params="name">
    <gazebo reference="${name}_foot">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>2000.0</kp>
      <kd>50.0</kd>
      <maxVel>0.5</maxVel>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:foot_contact name="FL"/>
  <xacro:foot_contact name="FR"/>
  <xacro:foot_contact name="RL"/>
  <xacro:foot_contact name="RR"/>

  <gazebo>
    <plugin name="p3d_base" filename="libgazebo_ros_p3d.so">
      <ros><remapping>odom:=/odom_physics</remapping></ros>
      <body_name>base_link</body_name>
      <frame_name>odom</frame_name>
      <update_rate>50.0</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find qda_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
    <selfCollide>false</selfCollide>
  </gazebo>

  <xacro:macro name="leg_if" params="name">
    <joint name="${name}_hip_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${name}_thigh_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${stand_thigh}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${name}_calf_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${stand_calf}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="arm_if" params="prefix">
    <joint name="${prefix}_joint_link1">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${arm_home_1}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_joint_link2">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${arm_home_2}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_joint_link3">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${arm_home_3}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_joint_link4">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${arm_home_4}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_joint_link5">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${arm_home_5}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_joint_link6">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${arm_home_6}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_joint_link7">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_finger_left_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.038</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="${prefix}_finger_right_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.038</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <xacro:leg_if name="FL"/>
    <xacro:leg_if name="FR"/>
    <xacro:leg_if name="RL"/>
    <xacro:leg_if name="RR"/>
    <xacro:arm_if prefix="left"/>
    <xacro:arm_if prefix="right"/>
  </ros2_control>
</robot>
