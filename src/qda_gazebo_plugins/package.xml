<?xml version="1.0"?>
<package format="3">
  <name>qda_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>Gazebo world plugin that welds a grasped object to the gripper.</description>
  <maintainer email="dev@example.com">qda</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>qda_interfaces</depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
