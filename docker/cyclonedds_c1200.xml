<?xml version="1.0" encoding="UTF-8" ?>
<!-- Opt-in LAN profile for the C1200 split test. It is not the default sim profile. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" />
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <Peers>
        <!-- C1200 eth3. The host-side peer is set in the board's matching file. -->
        <Peer address="192.168.1.100" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
