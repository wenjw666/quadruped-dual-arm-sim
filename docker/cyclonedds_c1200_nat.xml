<?xml version="1.0" encoding="UTF-8" ?>
<!-- Docker Desktop UDP-port-forwarded profile for the C1200 split test. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="true" />
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <ExternalNetworkAddress>192.168.1.101</ExternalNetworkAddress>
      <ExternalNetworkMask>255.255.255.0</ExternalNetworkMask>
    </General>
    <Discovery>
      <ParticipantIndex>0</ParticipantIndex>
      <Peers>
        <Peer address="192.168.1.100" />
      </Peers>
    </Discovery>
    <Compatibility>
      <ManySocketsMode>false</ManySocketsMode>
    </Compatibility>
  </Domain>
</CycloneDDS>
