<?xml version="1.0" encoding="UTF-8" ?>
<!-- C1200-side static peer for the Docker UDP-forwarded host. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface autodetermine="true" /></Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <ExternalNetworkAddress>192.168.1.100</ExternalNetworkAddress>
    </General>
    <Discovery>
      <ParticipantIndex>0</ParticipantIndex>
      <Peers><Peer address="192.168.1.101:9410" /></Peers>
    </Discovery>
    <Compatibility>
      <ManySocketsMode>false</ManySocketsMode>
    </Compatibility>
  </Domain>
</CycloneDDS>
